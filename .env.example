# Copie para .env.local (no seu computador) e coloque as mesmas variáveis na Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# O único e-mail Google que pode entrar e escrever.
OWNER_EMAIL=seu-email@gmail.com

# Endereço público do site (usado no retorno do login). Na Vercel, o domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
